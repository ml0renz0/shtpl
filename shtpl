#!/usr/bin/env bash
# shtpl: compile trusted templates into Bash, then optionally execute them.
set -euo pipefail

SHTPL_VERSION=2.0.0

usage() {
  cat <<'USAGE'
Usage: shtpl [--compile|--check] [--input FILE] [--output FILE]
       shtpl --help
       shtpl --version

Modes (default: render the template):
  --compile          Validate and emit generated Bash without executing it
  --check            Validate only; do not execute or emit output

Options:
  -i, --input FILE    Read from FILE (default: - for standard input)
  -o, --output FILE   Write to FILE (default: - for standard output)
  -h, --help          Show this help
  --version           Show the version

--check cannot be combined with --output.
Template execution is only safe for trusted input.
USAGE
}

cli_error() {
  printf 'shtpl: %s\n' "$1" >&2
  usage >&2
  return 2
}

record_lines() {
  local count=$1 source=$2
  while ((count > 0)); do
    generated_sources+=("$source")
    ((count -= 1))
  done
}

compile() {
  local line body lineno=0 top expected
  local -a blocks=() else_seen=() open_lines=()
  generated_sources=(0 0)

  printf '#!/usr/bin/env bash\nset -u\n'

  while IFS= read -r line || [[ -n $line ]]; do
    ((lineno += 1))

    case "$line" in
      '{% if '*' %}')
        body=${line#'{% if '}
        body=${body%' %}'}
        printf 'if [[ %s ]]; then\n:\n' "$body"
        record_lines 2 "$lineno"
        blocks+=(if)
        else_seen+=(0)
        open_lines+=("$lineno")
        ;;
      '{% for '*' %}')
        body=${line#'{% for '}
        body=${body%' %}'}
        printf 'for %s; do\n:\n' "$body"
        record_lines 2 "$lineno"
        blocks+=(for)
        else_seen+=(0)
        open_lines+=("$lineno")
        ;;
      '{% else %}')
        if (( ${#blocks[@]} == 0 )) || [[ ${blocks[-1]} != if ]]; then
          printf 'shtpl: unexpected else at line %d' "$lineno" >&2
          if ((${#blocks[@]})); then
            printf ' (inside %s opened at line %d)' "${blocks[-1]}" "${open_lines[-1]}" >&2
          fi
          printf '\n' >&2
          return 2
        fi
        top=$(( ${#blocks[@]} - 1 ))
        if (( else_seen[top] )); then
          printf 'shtpl: duplicate else at line %d (if opened at line %d)\n' "$lineno" "${open_lines[top]}" >&2
          return 2
        fi
        else_seen[top]=1
        printf 'else\n:\n'
        record_lines 2 "$lineno"
        ;;
      '{% endif %}'|'{% endfor %}')
        if [[ $line == '{% endif %}' ]]; then
          expected=if
        else
          expected=for
        fi
        if ((${#blocks[@]} == 0)) || [[ ${blocks[-1]} != "$expected" ]]; then
          if [[ $expected == if ]]; then
            printf 'shtpl: unexpected endif at line %d' "$lineno" >&2
          else
            printf 'shtpl: unexpected endfor at line %d' "$lineno" >&2
          fi
          if ((${#blocks[@]})); then
            printf ' (expected to close %s opened at line %d)' "${blocks[-1]}" "${open_lines[-1]}" >&2
          fi
          printf '\n' >&2
          return 2
        fi
        if [[ $expected == if ]]; then
          printf 'fi\n'
        else
          printf 'done\n'
        fi
        record_lines 1 "$lineno"
        top=$((${#blocks[@]} - 1))
        unset "blocks[$top]" "else_seen[$top]" "open_lines[$top]"
        ;;
      '{{ '*' }}')
        body=${line#'{{ '}
        body=${body%' }}'}
        if [[ $body =~ ^[a-zA-Z_][a-zA-Z_0-9]*= || $body =~ ^declare[[:space:]]+-[aA][[:space:]]+[a-zA-Z_][a-zA-Z_0-9]*= ]]; then
          printf '%s\n' "$body"
          record_lines 1 "$lineno"
        else
          emit_text "$line" "$lineno"
        fi
        ;;
      '{%'*)
        printf 'shtpl: invalid directive at line %d: %s\n' "$lineno" "$line" >&2
        return 2
        ;;
      *) emit_text "$line" "$lineno" ;;
    esac
  done

  if (( ${#blocks[@]} )); then
    printf 'shtpl: unclosed %s block opened at line %d (end of template at line %d)\n' "${blocks[-1]}" "${open_lines[-1]}" "$lineno" >&2
    return 2
  fi
}

emit_text() {
  local line=$1 lineno=$2 marker
  printf -v marker '__SHTPL_%08d__' "$lineno"
  while [[ $line == "$marker" ]]; do marker+=_; done
  # Comments must be literal; other text is expanded only by generated Bash.
  if [[ $line =~ ^[[:space:]]*# ]]; then
    printf "cat <<'%s'\n%s\n%s\n" "$marker" "$line" "$marker"
    record_lines 3 "$lineno"
  elif [[ $line == *\\ ]]; then
    # Protect the marker from a trailing backslash.
    printf '(\n__shtpl_line=$(cat <<%s\n%s.\n%s\n)\n' "$marker" "$line" "$marker"
    printf '%s\n' "printf '%s\n' \"\${__shtpl_line%.}\"" ')'
    record_lines 7 "$lineno"
  else
    printf 'cat <<%s\n%s\n%s\n' "$marker" "$line" "$marker"
    record_lines 3 "$lineno"
  fi
}

validate_bash() {
  local script=$1 diagnostic=$2 entry generated_line source_line message
  if bash -n "$script" 2>"$diagnostic"; then
    return 0
  fi

  # Bash reports line numbers in generated code. Translate them to template
  # lines, even when Bash points at an unexpected EOF just past the last line.
  while IFS= read -r entry || [[ -n $entry ]]; do
    if [[ $entry =~ line[[:space:]]+([0-9]+):[[:space:]]*(.*) ]]; then
      generated_line=${BASH_REMATCH[1]}
      message=${BASH_REMATCH[2]}
      source_line=${generated_sources[generated_line-1]-}
      if [[ -z $source_line ]]; then
        source_line=${generated_sources[-1]-0}
      fi
      printf 'shtpl: invalid Bash syntax at template line %s (generated line %d): %s\n' "$source_line" "$generated_line" "$message" >&2
      return 2
    fi
  done < "$diagnostic"

  printf 'shtpl: generated Bash failed syntax validation\n' >&2
  return 2
}

workdir= child_pid= temp_output=

cleanup_workspace() {
  if [[ -n ${temp_output-} ]]; then
    rm -f -- "$temp_output"
  fi
  if [[ -n ${workdir-} ]]; then
    rm -rf -- "$workdir"
  fi
}

handle_signal() {
  local exit_code=$1
  trap - HUP INT TERM
  if [[ -n ${child_pid-} ]]; then
    kill -TERM "$child_pid" 2>/dev/null || :
    wait "$child_pid" 2>/dev/null || :
    child_pid=
  fi
  exit "$exit_code"
}

run_generated() {
  local script=$1 status=0
  bash "$script" &
  child_pid=$!
  wait "$child_pid" || status=$?
  child_pid=
  return "$status"
}

process_template() {
  local mode=$1 input_file=$2 output_file=$3 script diagnostic parent
  umask 077
  workdir=$(mktemp -d -- "${TMPDIR:-/tmp}/shtpl.XXXXXXXX") || {
    printf 'shtpl: cannot create temporary workspace\n' >&2
    return 1
  }
  script=$workdir/generated.sh
  diagnostic=$workdir/diagnostics
  trap 'cleanup_workspace' EXIT
  trap 'handle_signal 129' HUP
  trap 'handle_signal 130' INT
  trap 'handle_signal 143' TERM

  if [[ $input_file == - ]]; then
    compile > "$script" || return $?
  else
    compile < "$input_file" > "$script" || return $?
  fi
  validate_bash "$script" "$diagnostic" || return $?
  if [[ $mode == check ]]; then
    return 0
  fi

  # Stage output alongside its destination for an atomic rename on success.
  # The original output remains untouched after failed validation or execution.
  if [[ $output_file != - ]]; then
    parent=$(dirname -- "$output_file") || return 1
    temp_output=$(mktemp -- "$parent/.shtpl.XXXXXXXX") || {
      printf 'shtpl: cannot create output file: %s\n' "$output_file" >&2
      return 1
    }
  fi

  case $mode in
    compile)
      if [[ $output_file == - ]]; then
        cat -- "$script" || return $?
      else
        cat -- "$script" > "$temp_output" || return $?
      fi
      ;;
    execute)
      if [[ $output_file == - ]]; then
        run_generated "$script" || return $?
      else
        run_generated "$script" > "$temp_output" || return $?
      fi
      ;;
  esac

  if [[ $output_file != - ]]; then
    mv -fT -- "$temp_output" "$output_file" || {
      printf 'shtpl: cannot publish output file: %s\n' "$output_file" >&2
      return 1
    }
    temp_output=
  fi
}

main() {
  local mode=execute input_file=- output_file=- mode_set=0 input_set=0 output_set=0
  local option value
  while (($#)); do
    case $1 in
      --help|-h)
        (($# == 1)) || { cli_error '--help cannot be combined with other options'; return 2; }
        usage
        return 0
        ;;
      --version)
        (($# == 1)) || { cli_error '--version cannot be combined with other options'; return 2; }
        printf 'shtpl %s\n' "$SHTPL_VERSION"
        return 0
        ;;
      --compile|--check)
        ((mode_set == 0)) || { cli_error 'choose only one mode'; return 2; }
        mode=${1#--}
        mode_set=1
        shift
        ;;
      -i|--input|-o|--output)
        option=$1
        (($# >= 2)) && [[ -n $2 ]] || { cli_error "missing value for $option"; return 2; }
        value=$2
        shift 2
        case $option in
          -i|--input)
            ((input_set == 0)) || { cli_error 'duplicate --input'; return 2; }
            input_file=$value
            input_set=1
            ;;
          -o|--output)
            ((output_set == 0)) || { cli_error 'duplicate --output'; return 2; }
            output_file=$value
            output_set=1
            ;;
        esac
        ;;
      --input=*|--output=*)
        option=${1%%=*}
        value=${1#*=}
        [[ -n $value ]] || { cli_error "missing value for $option"; return 2; }
        shift
        if [[ $option == --input ]]; then
          ((input_set == 0)) || { cli_error 'duplicate --input'; return 2; }
          input_file=$value
          input_set=1
        else
          ((output_set == 0)) || { cli_error 'duplicate --output'; return 2; }
          output_file=$value
          output_set=1
        fi
        ;;
      *)
        cli_error "unknown argument: $1"
        return 2
        ;;
    esac
  done
  if [[ $mode == check && $output_set == 1 ]]; then
    cli_error '--check does not accept --output'
    return 2
  fi
  process_template "$mode" "$input_file" "$output_file"
}

main "$@"
