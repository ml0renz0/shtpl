#!/usr/bin/env bash
# shtpl: compile trusted templates into Bash, then optionally execute them.
set -euo pipefail

usage() {
  printf 'Usage: shtpl [--compile|--help] < template.tpl\n'
}

compile() {
  local line body lineno=0 top
  local -a blocks=() else_seen=()

  printf '#!/usr/bin/env bash\nset -u\n'

  while IFS= read -r line || [[ -n $line ]]; do
    ((lineno += 1))

    case "$line" in
      '{% if '*' %}')
        body=${line#'{% if '}
        body=${body%' %}'}
        printf 'if [[ %s ]]; then\n:\n' "$body"
        blocks+=(if)
        else_seen+=(0)
        ;;
      '{% for '*' %}')
        body=${line#'{% for '}
        body=${body%' %}'}
        printf 'for %s; do\n:\n' "$body"
        blocks+=(for)
        else_seen+=(0)
        ;;
      '{% else %}')
        if (( ${#blocks[@]} == 0 )) || [[ ${blocks[-1]} != if ]]; then
          printf 'shtpl: unexpected else at line %d\n' "$lineno" >&2
          return 2
        fi
        top=$(( ${#blocks[@]} - 1 ))
        if (( else_seen[top] )); then
          printf 'shtpl: duplicate else at line %d\n' "$lineno" >&2
          return 2
        fi
        else_seen[top]=1
        printf 'else\n:\n'
        ;;
      '{% endif %}')
        [[ ${#blocks[@]} -gt 0 && ${blocks[-1]} == if ]] || { printf 'shtpl: unexpected endif at line %d\n' "$lineno" >&2; return 2; }
        printf 'fi\n'
        top=$(( ${#blocks[@]} - 1 ))
        unset "blocks[$top]" "else_seen[$top]"
        ;;
      '{% endfor %}')
        [[ ${#blocks[@]} -gt 0 && ${blocks[-1]} == for ]] || { printf 'shtpl: unexpected endfor at line %d\n' "$lineno" >&2; return 2; }
        printf 'done\n'
        top=$(( ${#blocks[@]} - 1 ))
        unset "blocks[$top]" "else_seen[$top]"
        ;;
      '{{ '*' }}')
        body=${line#'{{ '}
        body=${body%' }}'}
        if [[ $body =~ ^[a-zA-Z_][a-zA-Z_0-9]*= || $body =~ ^declare[[:space:]]+-[aA][[:space:]]+[a-zA-Z_][a-zA-Z_0-9]*= ]]; then
          printf '%s\n' "$body"
        else
          emit_text "$line" "$lineno"
        fi
        ;;
      *) emit_text "$line" "$lineno" ;;
    esac
  done

  if (( ${#blocks[@]} )); then
    printf 'shtpl: unclosed %s block\n' "${blocks[-1]}" >&2
    return 2
  fi
}

emit_text() {
  local line=$1 lineno=$2 marker
  printf -v marker '__SHTPL_%08d__' "$lineno"
  while [[ $line == "$marker" ]]; do marker+=_; done
  # Comments must be literal; other text is expanded only by generated Bash.
  if [[ $line =~ ^[[:space:]]*# ]]; then
    printf "cat <<'%s'\n%s\n%s\n" "$marker" "$line" "$marker"
  elif [[ $line == *\\ ]]; then
    # Protect the marker from a trailing backslash.
    printf '(\n__shtpl_line=$(cat <<%s\n%s.\n%s\n)\n' "$marker" "$line" "$marker"
    printf '%s\n' "printf '%s\n' \"\${__shtpl_line%.}\"" ')'
  else
    printf 'cat <<%s\n%s\n%s\n' "$marker" "$line" "$marker"
  fi
}

execute() (
  local temp
  temp=$(mktemp "${TMPDIR:-/tmp}/shtpl.XXXXXXXX")
  trap 'rm -f -- "$temp"' EXIT
  compile > "$temp"
  bash "$temp"
)

main() {
  case ${1-} in
    --help|-h) usage ;;
    --compile) [[ $# == 1 ]] || { usage >&2; return 2; }; compile ;;
    '') execute ;;
    *) usage >&2; return 2 ;;
  esac
}

main "$@"
